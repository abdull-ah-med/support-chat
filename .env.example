# Repo-root Compose / frontend build env (gitignored when copied to `.env`).
# Used by docker compose variable substitution. App secrets for EC2 also live in
# backend/.env.prod (see backend/.env.prod.example).

# --- Postgres / Redis (Compose services) ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=support_chat
REDIS_PASSWORD=replace-with-strong-redis-password

# --- Backend (also set in backend/.env or backend/.env.prod) ---
APP_ENV=local
COOKIE_SECURE=false
JWT_SECRET=replace-with-at-least-sixty-four-random-characters-please-do-not-use
WIDGET_TOKEN_SECRET=replace-with-a-different-sixty-four-plus-random-characters-widget
RATE_KEY_SECRET=replace-with-a-third-sixty-four-plus-random-characters-rate-keys
WIDGET_CSP_SERVICE_SECRET=replace-with-a-fourth-sixty-four-plus-random-characters-csp-service
STAFF_APP_ORIGIN=http://localhost:3000
WIDGET_ORIGIN=http://widget.localhost:3000
MARKETING_HOST_ORIGIN=http://host.localhost:3000
TRUSTED_PROXY_CIDRS=
CHAT_RETENTION_DAYS=30
RATE_WIDGET_CSP_IP=120
RATE_WIDGET_CSP_SITE=3000
RATE_WIDGET_CSP_WINDOW=60
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536

# --- Frontend build args ---
FRONTEND_API_ORIGIN=http://backend:8000
NEXT_PUBLIC_API_ORIGIN=
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:3000
NEXT_PUBLIC_STAFF_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_MARKETING_HOST_ORIGIN=http://localhost:3000
NEXT_PUBLIC_DEMO_SITE_KEY=demo
NEXT_PUBLIC_DEMO_PUBLIC_KEY=

# --- Published ports (local) ---
POSTGRES_PORT=55432
REDIS_PORT=56379
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- EC2 / sslip.io example (copy into .env on the instance; do not commit) ---
# APP_ENV=production
# COOKIE_SECURE=true
# STAFF_HOST=203-0-113-10.sslip.io
# MARKETING_HOST=marketing.203-0-113-10.sslip.io
# WIDGET_HOST=widget.203-0-113-10.sslip.io
# LETSENCRYPT_EMAIL=ops@example.com
# STAFF_APP_ORIGIN=https://203-0-113-10.sslip.io
# WIDGET_ORIGIN=https://widget.203-0-113-10.sslip.io
# MARKETING_HOST_ORIGIN=https://marketing.203-0-113-10.sslip.io
# WIDGET_CSP_SERVICE_SECRET=<same strong secret in backend and frontend containers>
# NEXT_PUBLIC_WIDGET_ORIGIN=https://widget.203-0-113-10.sslip.io
# NEXT_PUBLIC_STAFF_APP_ORIGIN=https://203-0-113-10.sslip.io
# NEXT_PUBLIC_MARKETING_HOST_ORIGIN=https://marketing.203-0-113-10.sslip.io
# TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# REDIS_TLS_DIR=./deploy/redis-tls

# Repo-root Compose / frontend build env (gitignored when copied to `.env`).
# Used by docker compose variable substitution. App secrets for EC2 also live in
# backend/.env.prod (see backend/.env.prod.example).

# --- Postgres / Redis (Compose services) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-admin-postgres-password
POSTGRES_DB=support_chat
APP_DB_USER=chat_app
APP_DB_PASSWORD=replace-with-strong-app-postgres-password
MIGRATION_DB_USER=chat_migrator
MIGRATION_DB_PASSWORD=replace-with-strong-migration-postgres-password
REDIS_APP_PASSWORD=replace-with-strong-app-redis-password
REDIS_ADMIN_PASSWORD=replace-with-distinct-strong-admin-redis-password
# Production Redis memory ceiling (volatile-lru eviction). Keep below REDIS_MEM_LIMIT (default 1g).
REDIS_MAXMEMORY=512mb

# --- Backend (also set in backend/.env or backend/.env.prod) ---
APP_ENV=local
COOKIE_SECURE=false
JWT_SECRET=replace-with-at-least-sixty-four-random-characters-please-do-not-use
WIDGET_TOKEN_SECRET=replace-with-a-different-sixty-four-plus-random-characters-widget
RATE_KEY_SECRET=replace-with-a-third-sixty-four-plus-random-characters-rate-keys
WIDGET_CSP_SERVICE_SECRET=replace-with-a-fourth-sixty-four-plus-random-characters-csp-service
STAFF_APP_ORIGIN=http://localhost:3000
WIDGET_ORIGIN=http://widget.localhost:3000
MARKETING_HOST_ORIGIN=http://host.localhost:3000
TRUSTED_PROXY_CIDRS=
CHAT_RETENTION_DAYS=30
RATE_WIDGET_CSP_IP=120
RATE_WIDGET_CSP_SITE=3000
RATE_WIDGET_CSP_WINDOW=60
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536

# --- Frontend build args ---
FRONTEND_API_ORIGIN=http://backend:8000
NEXT_PUBLIC_API_ORIGIN=
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:3000
NEXT_PUBLIC_STAFF_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_MARKETING_HOST_ORIGIN=http://localhost:3000
NEXT_PUBLIC_DEMO_SITE_KEY=demo
NEXT_PUBLIC_DEMO_PUBLIC_KEY=

# --- Published ports (local) ---
POSTGRES_PORT=55432
REDIS_PORT=56379
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- EC2 / sslip.io example (copy into .env on the instance; do not commit) ---
# APP_ENV=production
# COOKIE_SECURE=true
# STAFF_HOST=203-0-113-10.sslip.io
# MARKETING_HOST=marketing.203-0-113-10.sslip.io
# WIDGET_HOST=widget.203-0-113-10.sslip.io
# LETSENCRYPT_EMAIL=ops@example.com
# STAFF_APP_ORIGIN=https://203-0-113-10.sslip.io
# WIDGET_ORIGIN=https://widget.203-0-113-10.sslip.io
# MARKETING_HOST_ORIGIN=https://marketing.203-0-113-10.sslip.io
# WIDGET_CSP_SERVICE_SECRET=<same strong secret in backend and frontend containers>
# NEXT_PUBLIC_WIDGET_ORIGIN=https://widget.203-0-113-10.sslip.io
# NEXT_PUBLIC_STAFF_APP_ORIGIN=https://203-0-113-10.sslip.io
# NEXT_PUBLIC_MARKETING_HOST_ORIGIN=https://marketing.203-0-113-10.sslip.io
# In backend/.env.prod set TRUSTED_PROXY_CIDRS=172.18.0.1/32 (the current gateway).
# Check docker network inspect support-chat_default; auto requires future app support.
# REDIS_TLS_DIR=./deploy/redis-tls
# Per-service limits (defaults suit a 16 GiB host; lower them on a smaller instance; there are no CPU limits):
# REDIS_MEM_LIMIT=1g
# BACKEND_MEM_LIMIT=2g
# WORKER_MEM_LIMIT=4g
# FRONTEND_MEM_LIMIT=1g

# --- Abuse and cost controls ---
# Opt-in: visitor IPs are sent to IP_GEOLOCATION_PROVIDER_URL only when this is true.
IP_GEOLOCATION_ENABLED=false
# Postgres pool and server-side limits (statement timeout bounds a runaway query).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Bot turns per process, and background jobs the durable worker runs at once.
BOT_TURN_CONCURRENCY=8
DURABLE_WORK_CONCURRENCY=4
# Staff sign-in: failures per (email, ip), per ip, and per email across all IPs. The email-only
# ceiling never blocks valid credentials; it rejects and delays wrong guesses.
RATE_LOGIN_FAILURE=10
RATE_LOGIN_IP_FAILURE=100
RATE_LOGIN_EMAIL_FAILURE=50
RATE_LOGIN_DELAY_AFTER=3
RATE_LOGIN_DELAY_STEP_SECONDS=0.5
RATE_LOGIN_DELAY_MAX_SECONDS=4
# Every widget bootstrap from one IP, whatever the site key.
RATE_BOOTSTRAP_IP=240
RATE_BOOTSTRAP_IP_WINDOW=600
# Staff browser-error reports and workspace search, per user.
RATE_CLIENT_LOG=20
RATE_CLIENT_LOG_WINDOW=60
CLIENT_LOG_DEDUPE_SECONDS=60
RATE_WORKSPACE_SEARCH=60
RATE_WORKSPACE_SEARCH_WINDOW=60
# Staff sessions: a login ends after this many days however often it is refreshed; replaying the
# just-rotated refresh token inside the grace window is treated as a race, not theft.
REFRESH_ABSOLUTE_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=30
# Daily (UTC) provider budgets per site and across all sites; 0 disables a limit. When one is
# spent the assistant answers "cannot answer right now" and offers a person. BUDGET_KILL_SWITCH=true
# stops every paid provider call (LLM, embeddings, avatar) immediately.
BUDGET_KILL_SWITCH=false
BUDGET_LLM_CALLS_SITE_DAY=5000
BUDGET_LLM_CALLS_GLOBAL_DAY=20000
BUDGET_LLM_TOKENS_SITE_DAY=5000000
BUDGET_LLM_TOKENS_GLOBAL_DAY=20000000
BUDGET_EMBED_CALLS_SITE_DAY=5000
BUDGET_EMBED_CALLS_GLOBAL_DAY=20000
BUDGET_AVATAR_SECONDS_SITE_DAY=7200
BUDGET_AVATAR_SECONDS_GLOBAL_DAY=28800

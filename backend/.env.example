# Local defaults. Prefer: cd backend && ./scripts/docker_up.sh
# Host-run API against Compose Postgres/Redis uses the 127.0.0.1 URLs below.
# Inside the api container, Compose overrides DATABASE_URL / REDIS_URL to service DNS.

DATABASE_URL=postgresql+asyncpg://chat:chat@127.0.0.1:55432/support_chat
REDIS_URL=redis://:local-dev-redis@127.0.0.1:56379/0
JWT_SECRET=replace-with-at-least-sixty-four-random-characters-please-do-not-use
WIDGET_TOKEN_SECRET=replace-with-a-different-sixty-four-plus-random-characters-widget
RATE_KEY_SECRET=replace-with-a-third-sixty-four-plus-random-characters-rate-keys
COOKIE_SECURE=false
APP_ENV=local
STAFF_APP_ORIGIN=http://localhost:3000
WIDGET_ORIGIN=http://widget.localhost:3000
MARKETING_HOST_ORIGIN=http://host.localhost:3000
WIDGET_FRAME_ANCESTORS=http://localhost:3000,http://host.localhost:3000
TRUSTED_PROXY_CIDRS=
CHAT_RETENTION_DAYS=30
RATE_BOOTSTRAP=60
RATE_BOOTSTRAP_WINDOW=600
RATE_VISITOR_CREATE=10
RATE_VISITOR_CREATE_WINDOW=3600
RATE_VISITOR_SUBMIT=20
RATE_VISITOR_SUBMIT_WINDOW=60
RATE_VISITOR_SUBMIT_IP=60
RATE_VISITOR_SUBMIT_IP_WINDOW=60
RATE_LOGIN_FAILURE=10
RATE_LOGIN_FAILURE_WINDOW=900
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=500
ANTHROPIC_TIMEOUT=30
HAIKU_MODEL=claude-haiku-4-5-20251001
HAIKU_MAX_TOKENS=350
HAIKU_TIMEOUT=10
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536
EMBED_QUERY_TIMEOUT=3
EMBED_INGEST_TIMEOUT=30
EMBED_BATCH=32
CHUNK_TARGET_CHARS=1800
CHUNK_OVERLAP_CHARS=200
OPENAI_EMBED_MAX_TOKENS=8000
MAX_ANSWER_CHARS=20000
MAX_BOT_ANSWER_CHARS=2000
ANTHROPIC_CALLS_PER_MINUTE=6
FULL_CONTEXT_MAX_TOKENS=50000
FAST_PATH_MIN_SCORE=0.15
FAST_PATH_MARGIN_RATIO=1.5
CONVERSATION_WINDOW_SIZE=6
QUERY_VECTOR_CACHE_TTL=300

# Production (set real values; do not commit them):
# APP_ENV=production
# COOKIE_SECURE=true
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_MAX_TOKENS=1024
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_EMBED_DIM=1536
# JWT_SECRET=
# WIDGET_TOKEN_SECRET=
# RATE_KEY_SECRET=
# WIDGET_ORIGIN=https://widget.example
# STAFF_APP_ORIGIN=https://admin.example
# MARKETING_HOST_ORIGIN=https://sample-site.example.com
# WIDGET_FRAME_ANCESTORS=https://sample-site.example.com,https://sample-services.example.com
# DATABASE_URL=
# REDIS_URL=
# TRUSTED_PROXY_CIDRS=10.0.0.0/8
# CHAT_RETENTION_DAYS=
# RATE_BOOTSTRAP=60
# RATE_VISITOR_CREATE=10
# RATE_VISITOR_SUBMIT=20
# RATE_VISITOR_SUBMIT_IP=60
# RATE_LOGIN_FAILURE=10

# EC2 app env for the backend container (gitignored as backend/.env.prod).
# Names match backend/app/settings.py (pydantic Settings / env vars).
# Compose DNS: hostnames `postgres` and `redis` (see docker-compose.prod.yml).

APP_ENV=production
COOKIE_SECURE=true
# API containers must keep this false; the Compose worker service sets true.
ENABLE_BACKGROUND_WORKERS=false

# Passwords must match the dedicated application identities in repo-root .env.
DATABASE_URL=postgresql+asyncpg://chat_app:REPLACE_URL_ENCODED_APP_DB_PASSWORD@postgres:5432/support_chat
REDIS_URL=rediss://app:REPLACE_URL_ENCODED_REDIS_APP_PASSWORD@redis:6379/0?ssl_cert_reqs=required&ssl_ca_certs=/run/secrets/redis-ca.crt

JWT_SECRET=replace-with-at-least-sixty-four-random-characters-please-do-not-use
WIDGET_TOKEN_SECRET=replace-with-a-different-sixty-four-plus-random-characters-widget
RATE_KEY_SECRET=replace-with-a-third-sixty-four-plus-random-characters-rate-keys
WIDGET_CSP_SERVICE_SECRET=replace-with-a-fourth-sixty-four-plus-random-characters-csp-service

# These are three distinct canonical origins. Do not add paths or trailing slashes.
STAFF_APP_ORIGIN=https://REPLACE_BASE_DOMAIN
WIDGET_ORIGIN=https://widget.REPLACE_BASE_DOMAIN
MARKETING_HOST_ORIGIN=https://marketing.REPLACE_BASE_DOMAIN

# Honor X-Forwarded-For only from the docker0 gateway in front of the API container.
# Confirm with: docker inspect <backend> --format '{{.NetworkSettings.Gateway}}'
TRUSTED_PROXY_CIDRS=172.18.0.1/32

CHAT_RETENTION_DAYS=30
RATE_WIDGET_CSP_IP=120
RATE_WIDGET_CSP_SITE=3000
RATE_WIDGET_CSP_WINDOW=60

ANTHROPIC_API_KEY=REPLACE_WITH_REAL_ANTHROPIC_KEY
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=REPLACE_WITH_REAL_OPENAI_KEY
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536

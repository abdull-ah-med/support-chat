# EC2 app env for the backend container (gitignored as backend/.env.prod).
# Names match backend/app/settings.py (pydantic Settings / env vars).
# Compose DNS: hostnames `postgres` and `redis` (see docker-compose.prod.yml).

APP_ENV=production
COOKIE_SECURE=true
# API containers must keep this false; the Compose worker service sets true.
ENABLE_BACKGROUND_WORKERS=false

# Passwords must match the dedicated application identities in repo-root .env.
DATABASE_URL=postgresql+asyncpg://chat_app:REPLACE_URL_ENCODED_APP_DB_PASSWORD@postgres:5432/support_chat
REDIS_URL=rediss://app:REPLACE_URL_ENCODED_REDIS_APP_PASSWORD@redis:6379/0?ssl_cert_reqs=required&ssl_ca_certs=/run/secrets/redis-ca.crt

JWT_SECRET=replace-with-at-least-sixty-four-random-characters-please-do-not-use
WIDGET_TOKEN_SECRET=replace-with-a-different-sixty-four-plus-random-characters-widget
RATE_KEY_SECRET=replace-with-a-third-sixty-four-plus-random-characters-rate-keys
WIDGET_CSP_SERVICE_SECRET=replace-with-a-fourth-sixty-four-plus-random-characters-csp-service

# These are three distinct canonical origins. Do not add paths or trailing slashes.
STAFF_APP_ORIGIN=https://REPLACE_BASE_DOMAIN
WIDGET_ORIGIN=https://widget.REPLACE_BASE_DOMAIN
MARKETING_HOST_ORIGIN=https://marketing.REPLACE_BASE_DOMAIN

# Honor X-Forwarded-For only from the compose network gateway in front of the API.
# Confirm with: docker network inspect support-chat_default --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# HEAD settings/healthchecks/compose exec need an explicit single /32. auto comes once the app supports it.
TRUSTED_PROXY_CIDRS=172.18.0.1/32

# Query-embedding cache lifetime in seconds (default 86400). One vector is ~30 KB per distinct
# query, so keep it short; Redis is also capped by REDIS_MAXMEMORY (SEC-2).
QUERY_VECTOR_CACHE_TTL=3600

CHAT_RETENTION_DAYS=30
RATE_WIDGET_CSP_IP=120
RATE_WIDGET_CSP_SITE=3000
RATE_WIDGET_CSP_WINDOW=60

ANTHROPIC_API_KEY=REPLACE_WITH_REAL_ANTHROPIC_KEY
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=REPLACE_WITH_REAL_OPENAI_KEY
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536

# Talking avatar (HeyGen LiveAvatar, optional). Leave the key empty to keep the feature off.
# Production rejects LIVEAVATAR_SANDBOX=true.
LIVEAVATAR_API_KEY=
LIVEAVATAR_API_URL=https://api.liveavatar.com
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
# Name the avatar introduces itself with; must match the avatar's face. Blank: "the virtual assistant".
LIVEAVATAR_AVATAR_NAME=
LIVEAVATAR_SANDBOX=false
LIVEAVATAR_MAX_SESSION_SECONDS=600
AVATAR_SESSIONS_PER_CONVERSATION=5
RATE_AVATAR_SESSION=6
RATE_AVATAR_SESSION_WINDOW=3600
RATE_AVATAR_SESSION_IP=30
IP_GEOLOCATION_PROVIDER_URL=https://free.freeipapi.com/api/v1/json
# Set IP_GEOLOCATION_PROVIDER_URL= to disable sending visitor IPs for location lookup.

# --- Abuse and cost controls ---
# Opt-in: visitor IPs are sent to IP_GEOLOCATION_PROVIDER_URL only when this is true.
IP_GEOLOCATION_ENABLED=false
# Postgres pool and server-side limits (statement timeout bounds a runaway query).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# Bot turns per process, and background jobs the durable worker runs at once.
BOT_TURN_CONCURRENCY=8
DURABLE_WORK_CONCURRENCY=4
# Staff sign-in: failures per (email, ip), per ip, and per email across all IPs. The email-only
# ceiling never blocks valid credentials; it rejects and delays wrong guesses.
RATE_LOGIN_FAILURE=10
RATE_LOGIN_IP_FAILURE=100
RATE_LOGIN_EMAIL_FAILURE=50
RATE_LOGIN_DELAY_AFTER=3
RATE_LOGIN_DELAY_STEP_SECONDS=0.5
RATE_LOGIN_DELAY_MAX_SECONDS=4
# Every widget bootstrap from one IP, whatever the site key.
RATE_BOOTSTRAP_IP=240
RATE_BOOTSTRAP_IP_WINDOW=600
# Staff browser-error reports and workspace search, per user.
RATE_CLIENT_LOG=20
RATE_CLIENT_LOG_WINDOW=60
CLIENT_LOG_DEDUPE_SECONDS=60
RATE_WORKSPACE_SEARCH=60
RATE_WORKSPACE_SEARCH_WINDOW=60
# Staff sessions: a login ends after this many days however often it is refreshed; replaying the
# just-rotated refresh token inside the grace window is treated as a race, not theft.
REFRESH_ABSOLUTE_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=30
# Daily (UTC) provider budgets per site and across all sites; 0 disables a limit. When one is
# spent the assistant answers "cannot answer right now" and offers a person. BUDGET_KILL_SWITCH=true
# stops every paid provider call (LLM, embeddings, avatar) immediately.
BUDGET_KILL_SWITCH=false
BUDGET_LLM_CALLS_SITE_DAY=5000
BUDGET_LLM_CALLS_GLOBAL_DAY=20000
BUDGET_LLM_TOKENS_SITE_DAY=5000000
BUDGET_LLM_TOKENS_GLOBAL_DAY=20000000
BUDGET_EMBED_CALLS_SITE_DAY=5000
BUDGET_EMBED_CALLS_GLOBAL_DAY=20000
BUDGET_AVATAR_SECONDS_SITE_DAY=7200
BUDGET_AVATAR_SECONDS_GLOBAL_DAY=28800

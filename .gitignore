# Ignore everything at the repo root. Only allowlisted trees/files are committable.
# Plans, .cursor, .agents, docs, README stay on disk for agents.

/*
!/.gitignore
!/.pre-commit-config.yaml
!/.env.example
!/docker-compose.yml
!/docker-compose.prod.yml
!/frontend/
!/frontend/**
!/backend/
!/backend/**
!/deploy/
!/deploy/**
!/.github/
!/.github/**

# Secrets and junk inside the allowed trees
**/.env
**/.env.*
!**/.env.example
!**/.env.prod.example
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.oxlintcache
**/.oxfmtrcache
**/.coverage
**/.coverage.*
**/coverage/
**/htmlcov/
**/*.egg-info/
**/dist/
**/build/
**/node_modules/
**/.next/
**/out/
**/.turbo/
**/.deepeval/
**/*.log
**/*.tsbuildinfo
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/.idea/
**/.vscode/
**/docker-compose.override.yml

# Local docs and agent notes stay untracked
**/README.md
**/AGENTS.md
**/CLAUDE.md
backend/docs/
frontend/docs/
**/.cursor/
**/.agents/
**/plans/

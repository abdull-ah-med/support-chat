# Three-origin edge for SupportChat on one EC2 instance. Certbot adds the
# corresponding TLS listeners and redirects HTTP to HTTPS.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;

# Marketing/demo surface: no backend, auth, staff API, or WebSocket access.
server {
    listen 80;
    server_name __MARKETING_HOST__;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    location = / {
        proxy_pass http://127.0.0.1:3000;
    }

    location = /demo {
        proxy_pass http://127.0.0.1:3000;
    }

    location ^~ /_next/ {
        proxy_pass http://127.0.0.1:3000;
    }

    location / {
        return 404;
    }
}

# Staff surface: staff HTML, authentication, administrative APIs, and agent socket only.
server {
    listen 80;
    server_name __STAFF_HOST__;

    client_max_body_size 8m;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    location = /health {
        proxy_pass http://127.0.0.1:8000;
    }

    location ^~ /auth/ {
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:8000;
    }

    location = /api/public/widget-bootstrap {
        return 404;
    }

    location ^~ /api/internal/ {
        return 404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
    }

    location = /ws/agent {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    location ^~ /ws/ {
        return 404;
    }

    location = /widget {
        return 404;
    }

    location = /supportchat.js {
        return 404;
    }

    location = / {
        return 302 /inbox;
    }

    location = /demo {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# Public widget surface: loader, iframe, bootstrap, and visitor socket only.
server {
    listen 80;
    server_name __WIDGET_HOST__;

    client_max_body_size 32k;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    location = /api/public/widget-bootstrap {
        proxy_pass http://127.0.0.1:8000;
    }

    location = /ws/visitor {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    location = /widget {
        proxy_pass http://127.0.0.1:3000;
    }

    location = /supportchat.js {
        proxy_pass http://127.0.0.1:3000;
    }

    location ^~ /_next/ {
        proxy_pass http://127.0.0.1:3000;
    }

    location / {
        return 404;
    }
}

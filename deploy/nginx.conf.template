# Host nginx for support-chat on a single EC2 (inbox-triage pattern).
# Replace __PUBLIC_HOST__ with your sslip.io hostname (e.g. 3-12-34-56.sslip.io),
# install as /etc/nginx/conf.d/support-chat.conf, then:
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d __PUBLIC_HOST__
#
# Backend/frontend must listen on 127.0.0.1 only (docker-compose.prod.yml).

server {
    listen 80;
    server_name __PUBLIC_HOST__ staff.__PUBLIC_HOST__ widget.__PUBLIC_HOST__;

    client_max_body_size 8m;

    location /health {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /auth/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Server-to-server only. The frontend container reaches this route over the
    # private Docker network; it must never be exposed at the public edge.
    location ^~ /api/internal/ {
        return 404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

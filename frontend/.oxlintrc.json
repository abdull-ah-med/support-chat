{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "node_modules/**",
    "next-env.d.ts",
    "public/supportchat.js"
  ],
  "plugins": [
    "unicorn",
    "typescript",
    "oxc",
    "react",
    "react-perf",
    "nextjs",
    "jsx-a11y",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "settings": {
    "next": {
      "rootDir": "."
    },
    "react": {
      "version": "19.2.8"
    }
  },
  "rules": {
    "eslint/complexity": ["error", { "max": 10 }],
    "eslint/max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": false
      }
    ],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "eslint/no-underscore-dangle": ["error", { "allow": ["__supportchat"] }]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test/**", "vitest.config.mts"],
      "env": {
        "vitest": true
      },
      "rules": {
        "import/no-unassigned-import": "off",
        "vitest/require-mock-type-parameters": "off"
      }
    }
  ]
}
